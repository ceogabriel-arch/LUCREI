PORT=3000
# Pooled connection (app runtime) — Neon: hostname includes "-pooler"
DATABASE_URL="postgresql://user:password@localhost:5432/lucrei?pgbouncer=true"
# Direct connection (migrations) — Neon: hostname without "-pooler"
DIRECT_URL="postgresql://user:password@localhost:5432/lucrei"
# sandbox ou live
SHOPEE_ENV=sandbox
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_CALLBACK_URL=http://localhost:3000/shopee/callback
APP_SCHEME=lucreimobile
JWT_SECRET=
