PORT=3000
# Pooled connection (app runtime) — Neon: hostname includes "-pooler"
DATABASE_URL="postgresql://user:password@localhost:5432/lucrei?pgbouncer=true"
# Direct connection (migrations) — Neon: hostname without "-pooler"
DIRECT_URL="postgresql://user:password@localhost:5432/lucrei"
# sandbox ou live
SHOPEE_ENV=sandbox
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_CALLBACK_URL=http://localhost:3000/shopee/callback
APP_SCHEME=lucreimobile
JWT_SECRET=
# E-mails (separados por vírgula) com acesso à tela /admin
ADMIN_EMAILS=

# Apple IAP (App Store Server API + verificação de compra/webhook)
# sandbox ou production
APPLE_IAP_ENV=sandbox
# ascAppId do app (mesmo valor do eas.json > submit.production.ios.ascAppId)
APPLE_APP_APPLE_ID=6825893225
# Gerados em App Store Connect > Users and Access > Integrations > App Store Server API
APPLE_ISSUER_ID=
APPLE_KEY_ID=
# Conteúdo do arquivo .p8 numa linha só, com \n literal no lugar das quebras de linha
APPLE_PRIVATE_KEY=

# TikTok Shop (Partner Center - app "Lucrei - Lucro real das suas vendas", Brasil)
TIKTOKSHOP_APP_KEY=
TIKTOKSHOP_APP_SECRET=
TIKTOKSHOP_SERVICE_ID=
TIKTOKSHOP_CALLBACK_URL=https://app.lucreiapp.com/tiktokshop/callback

# iFood (Portal do Desenvolvedor - app DISTRIBUIDO, vinculo por codigo no Portal do Parceiro)
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
