generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
}

enum SubscriptionProvider {
  stripe
  apple_iap
  google_iap
  mercado_pago
}

enum ShopStatus {
  active
  token_expired
  disconnected
}

enum ProductCostSource {
  manual
  import
}

enum ImportBatchStatus {
  processing
  completed
  failed
}

model User {
  id                           String              @id @default(cuid())
  email                        String              @unique
  passwordHash                 String
  name                         String?
  subscriptionStatus           SubscriptionStatus  @default(trialing)
  planId                       String?
  document                     String?
  trialEndsAt                  DateTime?
  passwordResetTokenHash       String?
  passwordResetTokenExpiresAt  DateTime?
  // Incrementado a cada troca de senha; embutido no JWT como "tv" e conferido
  // em toda requisição autenticada — invalida qualquer token emitido antes da troca.
  tokenVersion                 Int                 @default(0)
  // Token de push do Expo (um por conta - o último dispositivo a registrar vence).
  pushToken                    String?
  // "sub" do Google quando a conta foi criada ou vinculada via login Google.
  googleId                     String?             @unique
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt

  plan          Plan?           @relation(fields: [planId], references: [id])
  shops         Shop[]
  subscriptions Subscription[]

  @@index([planId])
  @@index([passwordResetTokenHash])
}

model Shop {
  id            String     @id @default(cuid())
  userId        String
  shopeeShopId  String     @unique
  shopName      String
  region        String     @default("BR")
  status        ShopStatus @default(active)
  connectedAt   DateTime   @default(now())
  disconnectedAt DateTime?
  lastSyncedAt  DateTime?

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthToken    ShopeeOAuthToken?
  products      Product[]
  orders        Order[]
  importBatches CostImportBatch[]

  @@index([userId])
}

model ShopeeOAuthToken {
  id                     String   @id @default(cuid())
  shopId                 String   @unique
  accessToken            String
  refreshToken           String
  accessTokenExpiresAt   DateTime
  refreshTokenExpiresAt  DateTime
  updatedAt              DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model Product {
  id             String            @id @default(cuid())
  shopId         String
  shopeeItemId   String?
  shopeeModelId  String?
  sku            String?
  name           String
  costPrice      Decimal           @db.Decimal(12, 2)
  costSource     ProductCostSource @default(manual)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  shop      Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  lineItems OrderLineItem[]

  @@index([shopId])
  @@index([shopeeItemId])
}

model Order {
  id                    String    @id @default(cuid())
  shopId                String
  shopeeOrderSn         String    @unique
  orderStatus           String
  orderDate             DateTime
  buyerPaidShippingFee  Decimal   @db.Decimal(12, 2)
  escrowAmount          Decimal?  @db.Decimal(12, 2)
  syncedAt              DateTime  @default(now())
  escrowSyncedAt        DateTime?

  shop      Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  lineItems OrderLineItem[]

  @@index([shopId])
}

model OrderLineItem {
  id                    String   @id @default(cuid())
  orderId               String
  productId             String?
  shopeeItemId          String?
  quantity              Int
  salePrice             Decimal  @db.Decimal(12, 2)
  shippingFeeAllocated  Decimal  @db.Decimal(12, 2)
  shopeeFeeAllocated    Decimal  @db.Decimal(12, 2)
  productCostSnapshot   Decimal? @db.Decimal(12, 2)
  refundAmount          Decimal? @db.Decimal(12, 2)
  profit                Decimal? @db.Decimal(12, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([shopeeItemId])
}

model CostImportBatch {
  id             String             @id @default(cuid())
  shopId         String
  fileName       String
  uploadedAt     DateTime           @default(now())
  rowCount       Int
  matchedCount   Int                @default(0)
  unmatchedCount Int                @default(0)
  status         ImportBatchStatus  @default(processing)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model Plan {
  id                String   @id @default(cuid())
  key               String   @unique
  name              String
  salesLimit        Int?
  integrationsLimit Int?
  priceOriginal     Decimal? @db.Decimal(12, 2)
  priceCurrent      Decimal? @db.Decimal(12, 2)
  sortOrder         Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users User[]
}

model Subscription {
  id                     String               @id @default(cuid())
  userId                 String
  provider               SubscriptionProvider
  providerCustomerId     String?
  providerSubscriptionId String?
  status                 SubscriptionStatus   @default(trialing)
  currentPeriodEnd       DateTime?
  lastInvoiceUrl         String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
