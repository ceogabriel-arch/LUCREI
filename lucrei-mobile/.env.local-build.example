# Config para scripts/build-android-local.sh - copie para .env.local-build
# (gitignorado) e preencha com os caminhos/senhas reais da sua máquina.
# Nunca commite o .env.local-build.

# Pasta do Android SDK (sdkmanager, platform-tools, etc.)
ANDROID_SDK_DIR=C:/Android/sdk

# Keystore de debug fixa (fora de android/, sobrevive a `expo prebuild --clean`).
# Gere uma vez com:
#   keytool -genkeypair -v -keystore lucrei-debug.keystore -alias androiddebugkey \
#     -keyalg RSA -keysize 2048 -validity 10000 -storepass android -keypass android \
#     -dname "CN=Android Debug,O=Android,C=US"
# O SHA-1 dela precisa estar cadastrado como Client ID Android no Google Cloud
# Console pro Google Sign-In funcionar nos builds locais (APK).
DEBUG_KEYSTORE_PATH=C:/Android/keystore/lucrei-debug.keystore

# Keystore de upload (a mesma usada em TODOS os envios ao Play Console -
# nunca gere uma nova, é a identidade permanente de assinatura do app).
UPLOAD_KEYSTORE_PATH=C:/Android/keystore/lucrei-upload-key.jks
UPLOAD_KEYSTORE_ALIAS=lucrei-upload
UPLOAD_KEYSTORE_PASSWORD=troque-me
